{
  "description": "watchdeck: one command for every hook. PreToolUse on Bash sandboxes skill scripts and command subjects and applies the rule packs; PreToolUse on Skill attributes skill use and applies agent rules; PreToolUse on Read|Write|Edit|MultiEdit|NotebookEdit, Grep|Glob, WebFetch|WebSearch and mcp__.* applies the rule packs and the policy's path, domain and MCP tool gates (deny or ask, never allow; no opinion when the policy has nothing for the tool); PostToolUse on WebFetch|WebSearch warns on a prompt-injection hit when that pack is on; PermissionDenied on every tool records auto-mode denials; SessionStart, SessionEnd and UserPromptSubmit record the session lifecycle (start, end, heartbeat) so the dashboard knows which sessions are live, and print nothing; when the user turned autostart on in watchdeck setup, SessionStart also starts the dashboard in the background. Requires the watchdeck binary on PATH or in ~/.local/share/watchdeck/bin; silently does nothing when it is missing.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/hook.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/hook.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/hook.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/hook.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/hook.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/hook.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "modules": [
    "./register.tsx"
  ]
}
