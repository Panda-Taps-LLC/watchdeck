<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.pandataps.watchdeck</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/you/.local/share/watchdeck/bin/watchdeck</string>
		<string>ui</string>
		<string>--service</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>/Users/you/state/watchdeck/ui.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/you/state/watchdeck/ui.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>XDG_STATE_HOME</key>
		<string>/Users/you/state</string>
	</dict>
</dict>
</plist>
