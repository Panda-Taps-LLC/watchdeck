(version 1)
(allow default)
(deny network*)
(deny file-write* (subpath "/Users/test"))
(allow file-write* (subpath "/Users/test/proj") (subpath "/private/tmp") (subpath "/private/var/folders/xx/T"))
(deny file-read* (subpath "/Users/test/.aws") (subpath "/Users/test/.claude") (subpath "/Users/test/.config/gcloud") (subpath "/Users/test/.docker/config.json") (subpath "/Users/test/.gnupg") (subpath "/Users/test/.netrc") (subpath "/Users/test/.ssh"))
(deny file-read* (regex #"(^|/)\.env$"))
(allow file-read* (subpath "/Users/test/.claude/skills/pdf"))
(deny file-write* (subpath "/Users/test/.aws") (subpath "/Users/test/.claude") (subpath "/Users/test/.config/gcloud") (subpath "/Users/test/.docker/config.json") (subpath "/Users/test/.gnupg") (subpath "/Users/test/.netrc") (subpath "/Users/test/.ssh"))
(deny file-write-unlink (literal "/Users"))
(deny file-write* (regex #"(^|/)\.env$"))
